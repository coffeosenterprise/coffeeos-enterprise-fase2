# Variables de entorno de referencia — Fase 1 v1.5
# Copiar a .env y ajustar por ambiente (Local/Development/Testing/Staging/Production)

# --- API ---
NODE_ENV=development
PORT=3000
JWT_SECRET=change_me_in_every_environment

# --- Base de datos (PostgreSQL) ---
# Rol administrador (superusuario) -- SOLO para migraciones y
# verificacion administrativa. La aplicacion NUNCA debe conectarse
# con esta URL en tiempo de ejecucion (ver ADR-022).
DATABASE_URL=postgresql://coffeeos:coffeeos_dev@localhost:5432/coffeeos?schema=public

# Rol restringido (no superusuario, no BYPASSRLS) -- el que la
# aplicacion usa realmente en tiempo de ejecucion (ADR-022).
# Requiere: 1) aplicar la migracion 0004 (crea el rol sin contraseña),
# 2) correr prisma/provisioning/set-app-role-password.sh con
# APP_DB_ROLE_PASSWORD definido -- la migracion NUNCA fija una
# contraseña real (ver correccion #3, Fase 1 v1.4).
APP_DATABASE_URL=postgresql://coffeeos_app:REEMPLAZAR_VIA_set-app-role-password.sh@localhost:5432/coffeeos?schema=public

# --- Redis (ADR-014) ---
REDIS_URL=redis://localhost:6379

# --- Object Storage compatible S3 (ADR-015) ---
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=coffeeos
OBJECT_STORAGE_SECRET_KEY=coffeeos_dev_secret
OBJECT_STORAGE_BUCKET=coffeeos-dev

# --- Mail testing service (solo Local/Development) ---
SMTP_HOST=localhost
SMTP_PORT=1025
